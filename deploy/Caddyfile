# ITX reverse proxy -- Caddy edition.
#
# Preferred over nginx because there is less to get wrong: TLS is
# automatic and correct by default, HSTS is on by default, and the
# timeouts below are the only tuning this deployment needs.
#
# Copy to /etc/caddy/Caddyfile, replace itx.example.com and the email,
# then:  sudo caddy validate --config /etc/caddy/Caddyfile
#        sudo systemctl reload caddy
#
# See docs/deployment.md §4 for why X-Forwarded-For is set the way it is.
# It is the one line here that is a security control rather than tuning.

{
	# Let's Encrypt registration + expiry notices. A real inbox: this is
	# where you find out a renewal has been failing for two weeks.
	email ops@example.com

	servers {
		timeouts {
			# Bounds slowloris: a client that opens a connection and
			# dribbles headers gets 10s, not forever.
			read_header 10s
			# Generous enough for a large signed payload on a bad
			# connection, short enough that a stalled upload is not a
			# held connection.
			read_body 30s
			# The ceiling on a hub response. The expensive routes are
			# node round trips and full-board walks; 60s is well past
			# anything healthy and still bounds a wedged handler.
			write 60s
			idle 120s
		}
	}
}

# The headers every request to the hub carries, wherever it entered.
#
# A snippet rather than two copies, because both hostnames now forward to
# the hub and the X-Forwarded-For line below is a security control: an
# apex route that forgot it would hand the hub whatever the client
# claimed, on a path the rate limiter charges by address. One definition
# means the two entrances cannot drift apart. See the `import` inside the
# API's `reverse_proxy` for why each line is what it is.
(itx_hub_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Host {host}
	header_up -Forwarded
	header_up -X-Real-IP
}

# The site. Static files, no hub behind it *except* for the three paths
# below, and the only thing a human visiting the domain reaches.
#
# Two hostnames rather than one with the hub under `/api`, and that is a
# correctness requirement rather than taste: the signed envelope binds
# the concrete request path, so mounting the hub under a prefix makes
# every authenticated request fail its own signature (§4.6). The hub's
# CORS layer already allows any origin for GETs, which is exactly what
# this page needs and nothing more.
#
#     sudo cp -r site/. /var/www/itx/      # from the release tarball
itx.example.com {
	encode zstd gzip
	root * /var/www/itx

	# Three paths that are NOT the single-page app, handled before it.
	#
	# The SPA fallback below answers every unknown path with index.html
	# and a 200, which is right for a route the router owns and wrong for
	# a file the outside world was told to fetch. Until 2026-09-09 that
	# swallowed all three of these: `/llms.txt` returned a page of HTML to
	# an agent expecting the manual, `/.well-known/security.txt` returned
	# HTML to a researcher and to every scanner that looks for it, and
	# `/health` returned 200 with the hub dead -- which is what §3's
	# off-box check and §8.2's monitoring both curl. A 200 full of markup
	# is the worst answer available: it satisfies a status-code check and
	# means nothing.
	#
	# `handle` blocks are mutually exclusive and evaluated in the order
	# written, so these three win and everything else falls to the app.

	# The agent manual, served by the hub itself so it cannot drift from
	# the running constants. Forwarded rather than copied for that reason,
	# and forwarded at all because the README's one-line paste hands a
	# stranger the site's domain -- an agent should not have to know the
	# API is on another hostname to read the instructions for using it.
	handle /llms.txt {
		reverse_proxy 127.0.0.1:9100 {
			import itx_hub_headers
		}
	}

	# `/health` on the name a human types. The API's own copy still
	# answers on hub.<domain>; this is the one §3 tells you to curl from
	# another machine, and it has to reach the hub to mean anything.
	handle /health {
		reverse_proxy 127.0.0.1:9100 {
			import itx_hub_headers
		}
	}

	# RFC 9116 disclosure contact, on the apex because that is where
	# `Canonical:` in the file itself says it lives -- and where a
	# researcher and every automated scanner will look first. Same file
	# and same install step as the API's copy:
	#     sudo install -Dm644 deploy/security.txt \
	#         /etc/caddy/well-known/security.txt
	handle /.well-known/security.txt {
		root * /etc/caddy/well-known
		rewrite * /security.txt
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}

	# Single-page app: unknown paths are routes the router owns, not
	# missing files, so they get index.html and React decides. A real
	# 404 for /nothing-here would break every deep link on the site.
	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Nothing is cached by default. index.html above all must not be:
		# it is what points at the current asset hashes, so a stale copy
		# asks the browser for a bundle that no longer exists.
		Cache-Control "no-cache"
	}

	# ...except the assets, which Vite gives content-addressed names, so
	# a changed file is a changed name and the old one can be kept
	# forever. Second, because two `header` directives run in the order
	# they appear and this one is the exception to the rule above.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

# The API. Everything below this line was the whole file before the site
# had a home, and it is unchanged apart from the hostname it answers on.
hub.itx.example.com {
	# Body cap. Derived from the hub's own limit rather than picked: the
	# hub accepts free-text fields (description, output, dispute reason)
	# of up to MAX_TEXT_FIELD_LENGTH = 20,000 *characters*, counted with
	# chars().count() in hub/src/handlers.rs and advertised in
	# /llms.txt. The Python SDK posts with requests' `json=`, which uses
	# json.dumps' default ensure_ascii=True, so every non-ASCII character
	# goes on the wire as \uXXXX -- 6 bytes for a BMP character, 12 for
	# an emoji (a surrogate pair). A full 20,000-character emoji field is
	# therefore 240,000 bytes of body for a payload the hub would accept.
	#
	# 262144 bytes (256 KiB) covers that with room for the envelope, and
	# is still an order of magnitude under axum's own 2MB extractor
	# default, so oversize bodies still die here rather than costing the
	# hub a read, a rate-limit slot, or an ECDSA verify. Written as a
	# plain byte count so it is exactly the same number as nginx.conf's
	# `client_max_body_size 256k` -- Caddy reads KB as 1000 and nginx
	# reads k as 1024, which is how the two "equivalent" configs used to
	# differ by 1,536 bytes without either looking wrong.
	request_body {
		max_size 262144
	}

	# RFC 9116 disclosure contact. Served here because the hub's router
	# has no route for it and adding one would be a code change; the
	# proxy is the right place for a static well-known file anyway.
	# Install with:
	#     sudo install -Dm644 deploy/security.txt \
	#         /etc/caddy/well-known/security.txt
	handle /.well-known/security.txt {
		root * /etc/caddy/well-known
		rewrite * /security.txt
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}

	# `/metrics` is not for the internet. It carries the custody balance,
	# the exchange's liabilities, the faucet budget's remaining headroom
	# and the reconciliation disagreement counters -- an operational
	# picture of the treasury, unauthenticated, on a route the hub does
	# not gate because inside the box it does not need to be.
	#
	# Shipped blocked rather than left to the operator. The runbook has
	# said to add this since the metrics endpoint landed, and neither
	# shipped config contained it, so the documented state and the
	# shipped state disagreed -- which is the same as not documenting it.
	# Scrape from the box (`curl -s localhost:9100/metrics`), or replace
	# the 404 with a `remote_ip` matcher for the monitoring host.
	@metrics path /metrics
	respond @metrics 404

	handle {
		# The path reaches the hub byte-for-byte as the client sent it,
		# and that is a correctness requirement, not a preference. Since
		# 2026-09-05 the signed envelope binds method and concrete path,
		# and the hub verifies against `OriginalUri` -- the path as it
		# arrived. A proxy that rewrites the path (a trailing slash on
		# nginx's `proxy_pass`, a `handle_path` strip here, mounting the
		# hub under /api) makes every authenticated request fail its
		# signature check, with a 100% 401 rate and nothing in either
		# log saying why. `handle` + a bare upstream address does no
		# rewriting; see docs/deployment.md §4.6 before changing it.
		reverse_proxy 127.0.0.1:9100 {
			# THE security-relevant line.
			#
			# Caddy's default is to APPEND the client to any X-Forwarded-For
			# the client itself sent. The hub reads the list right to left and
			# skips its own proxies (hub/src/rate_limit.rs, client_ip), so
			# appending is in fact safe today -- the rightmost entry is the
			# one we observed.
			#
			# We replace instead of appending anyway, so that exactly one
			# entry exists and it is the address this proxy actually saw.
			# That makes the config correct under a left-to-right reader too,
			# which is what protects it if the hub's parsing is ever changed
			# or a second proxy is added by someone who does not know the
			# rule. A spoofed header from a client is discarded here and
			# never reaches the hub at all.
			#
			# `caddy validate` emits "Unnecessary header_up
			# X-Forwarded-For: the reverse proxy's default behavior is
			# to pass headers to the upstream" for this line. The
			# warning is wrong here and must not be "fixed" by deleting
			# it -- verified against Caddy 2.11.4: with the line, a
			# client sending `X-Forwarded-For: 203.0.113.9` (or a whole
			# invented chain, or repeated headers) reaches the upstream
			# as exactly one entry, the real client address. Without it,
			# the client's value is preserved and appended to.
			# ...and the three below it: the hub does not read those, but
			# a future handler might, and they should mean what they say
			# rather than whatever a client asserted.
			#
			# All five live in the `itx_hub_headers` snippet at the top of
			# this file, because the apex forwards three paths to the hub
			# as well and one definition is what keeps the two entrances
			# from drifting.
			import itx_hub_headers

			# Deliberately NO active health check. There used to be a
			# `health_uri /health` here, and it was actively harmful.
			#
			# `handlers::health` asks the node for its chain tip and
			# answers 503 `{"status":"degraded"}` whenever the node is
			# unreachable. Caddy treats any non-2xx probe response as an
			# unhealthy upstream, and with exactly one upstream there is
			# nothing to fail over to -- so Caddy took every request off
			# the hub, reads included, the moment the node blinked. A
			# hub that is up and serving the whole read surface became
			# indistinguishable from a dead one, which contradicts what
			# §8.2 alerts on, and the §8.1 node self-ban took the entire
			# site down with it.
			#
			# The options were: accept 503 as healthy (`health_status`
			# takes one value, so it cannot say "200 or 503"), probe a
			# route that does not touch the node, or drop the check.
			# Dropping it is the right one here. A health check on a
			# single upstream can only ever remove capacity; if the hub
			# process is genuinely down, the dial fails and Caddy
			# answers 502 either way. Monitoring polls /health directly
			# (§8.2) and can tell 503-degraded from no answer at all,
			# which is the distinction that matters.
			#
			# If a second hub upstream is ever added, an active check
			# earns its place again -- but it must probe something that
			# does not depend on the node, or it will still take both
			# upstreams out together.
		}
	}

	# Deliberately NO `encode` directive. The hub already gzips its own
	# responses (CompressionLayer in build_router), and Caddy passes
	# Accept-Encoding upstream, so adding encode here would at best do
	# nothing and at worst cost a decompress/recompress cycle on the
	# largest responses.

	log {
		output file /var/log/caddy/itx-access.log {
			roll_size 100MiB
			roll_keep 14
		}
		format json
	}
}
