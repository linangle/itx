# ITX miner.
#
# Outbound only -- it dials the node and listens for nothing, so it needs
# no firewall rule.
#
# --public-key-file really is a public key: the address block rewards are
# paid to, and nothing bad happens if it is read. What is easy to miss is
# that it has a private half. The only generator is btclib's key_gen,
# which writes the pair together:
#
#     cargo run --release -p btclib --bin key_gen -- /var/lib/itx/miner
#     -> /var/lib/itx/miner.pub.pem     this file, public
#     -> /var/lib/itx/miner.priv.cbor   spends every block reward, ever
#
# The miner process never needs the private half, so generate the pair
# somewhere else and copy only the .pub.pem here. If it is on this box
# anyway, it is a fourth secret with no directory, no mode enforcement
# and no unit hardening aimed at it -- see docs/deployment.md §6.5.

[Unit]
Description=ITX miner
After=network-online.target itx-node.service
Wants=network-online.target

[Service]
Type=simple
User=itx
Group=itx
WorkingDirectory=/var/lib/itx

# Creates /var/lib/itx, owned by User=, before ExecStart -- so the unit
# does not silently depend on §5's mkdir having been run by hand.
StateDirectory=itx
StateDirectoryMode=0700

ExecStart=/usr/local/bin/itx-miner \
    --addresses 127.0.0.1:9000 \
    --public-key-file /var/lib/itx/miner.pub.pem

# The miner waits for its node rather than exiting when it cannot reach
# it (miner/src/main.rs, NodeLink): it retries with a backoff, stops
# mining while it has no fresh template, and picks up again when the node
# answers. So a miner started before the node, or running through a node
# restart or a maintenance window, stays up and idle rather than
# restart-looping -- which is why "miner unit flapping" now genuinely
# means the miner is broken, and "chain height is not moving" is read
# from the miner's own log (§9.6).
#
# No start limit, unlike itx-hub.service: nothing here should exit for a
# reason a restart would fix, so a limit would only turn a real crash
# loop into mining that stays stopped.
Restart=always
RestartSec=5s

Environment=RUST_LOG=info
# See itx-hub.service for why: tracing-subscriber colours its output
# unconditionally otherwise, and the journal ends up full of escapes.
Environment=NO_COLOR=1
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/itx

[Install]
WantedBy=multi-user.target
