# ITX agent hub -- the custodial HTTP API.
#
# This unit runs the process that holds the treasury, the exchange
# custody key, and the escrow master secret. Everything in the hardening
# block below is aimed at that.
#
# WorkingDirectory is load-bearing: the hub resolves its default key paths
# relative to it. The ExecStart below passes all three explicitly anyway,
# so the location is stated in one place rather than implied.

[Unit]
Description=ITX agent hub
# Not Requires=: the hub comes up and serves reads with the node down,
# reporting "degraded" from /health, which is more useful than refusing
# to start. See docs/deployment.md §8.2. (There used to be a second,
# identical After=itx-node.service line below the [Unit] block's other
# directives; systemd merges them, so it did nothing but suggest the two
# were saying different things.)
After=network-online.target itx-node.service
Wants=network-online.target

[Service]
Type=simple
User=itx
Group=itx
WorkingDirectory=/var/lib/itx

# Creates /var/lib/itx and /var/lib/itx/secrets, owned by User=, before
# ExecStart. Without this the unit depends on someone having run §5's
# mkdir by hand: key creation does not create parent directories, so a
# missing secrets/ is an immediate exit and Restart=always turns that into
# a restart loop on the box holding the treasury.
StateDirectory=itx itx/secrets
StateDirectoryMode=0700

# --generate-keys is explicit first-boot authority. It is safe to leave in
# the unit: if the store exists, the hub refuses to replace any missing key.
ExecStart=/usr/local/bin/itx-hub \
    --bind 127.0.0.1 \
    --port 9100 \
    --node-addresses 127.0.0.1:9000 \
    --store-file /var/lib/itx/hub.redb \
    --generate-keys \
    --operator-key-file /var/lib/itx/secrets/hub_operator.priv.cbor \
    --exchange-custody-key-file /var/lib/itx/secrets/hub_exchange_custody.priv.cbor \
    --escrow-secret-file /var/lib/itx/secrets/hub_escrow_secret.bin \
    --trusted-proxies 127.0.0.1,::1

# A restart is not free to clients, but it is no longer destructive.
# hub/src/auth.rs claims and fsyncs an envelope's signature BEFORE the
# handler runs, so a request killed mid-flight would die with its
# envelope already spent -- unretryable, because the replay guard now
# rejects that signature. The hub drains on SIGTERM, which is what
# `systemctl restart` sends, so in-flight requests finish first.
# Requests arriving during the drain are refused at the socket, which is
# a clean failure the client can retry with the same envelope. See
# docs/deployment.md §9.9.
Restart=always
RestartSec=5s

# systemd's default stop timeout is 90s and its default is to SIGKILL
# after it. The drain above is bounded by whatever the slowest in-flight
# handler is waiting on, and a handler waiting on a wedged node can sit
# for the node client's own timeouts -- so a restart at exactly the wrong
# moment kills the drain and burns the envelopes it was protecting, which
# is the one thing the drain exists to prevent. Generous rather than
# tight: a stop that takes two minutes is an inconvenience, a stop that
# SIGKILLs a treasury process mid-write is not.
TimeoutStopSec=120

# systemd gives a service 1024 file descriptors by default, and the hub
# is a server. Every kept-alive upstream connection from the proxy, the
# node pool, and redb's own handles come out of the same budget, and the
# thousand-agent load test was run on macOS by hand -- never under
# systemd, so this ceiling has never been met in a measurement. `accept`
# returning EMFILE presents as a hub that has stopped answering while
# looking perfectly healthy in every metric it reports about itself.
LimitNOFILE=65536

Environment=RUST_LOG=info
# tracing-subscriber's fmt layer turns ANSI colours on whenever the
# `ansi` feature is compiled in -- it does not check for a terminal -- so
# without this the journal holds escape sequences wrapped around every
# level and target. It honours NO_COLOR (tracing-subscriber 0.3.23,
# fmt_layer.rs). Plain text is what makes §8.4's greps work.
Environment=NO_COLOR=1
# Anything the hub creates is owner-only. The hub already chmods its own
# key files to 0600, but this covers hub.redb and everything else -- and
# hub.redb is not nothing even after escrow key derivation landed: it
# still holds the whole board, every account, and the replay log.
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/itx

# The hub's secrets are worth a core-dump rule of their own: a dump
# written by a crash is a plaintext copy of all three keys in a path
# nothing else in this unit protects.
LimitCORE=0

[Install]
WantedBy=multi-user.target
